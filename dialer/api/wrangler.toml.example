name = "graymatter-power-dialer"
main = "worker.js"
compatibility_date = "2026-10-01"
workers_dev = true

[[d1_databases]]
binding = "DB"
database_name = "graymatter-power-dialer"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

[vars]
ALLOWED_ORIGIN = "https://graymatterdigitalsolutions.com"
VOICE_WEBHOOK_URL = "https://REPLACE_WITH_WORKER_URL/voice"

# Set these ONLY as secrets with 'npx wrangler secret put <NAME>':
# OPERATOR_KEY
# TWILIO_ACCOUNT_SID
# TWILIO_API_KEY_SID
# TWILIO_API_KEY_SECRET
# TWILIO_TWIML_APP_SID
# TWILIO_AUTH_TOKEN
# TWILIO_FROM_NUMBER
