---
// StickyCallBar — the mobile conversion primitive. Persistent bottom
// bar, tap-to-call plus directions, present on every page via
// BaseLayout. Pure CSS position:fixed, no JS. Both targets are at
// least --tap-target-min (44px) tall, full width divided evenly. Both
// hrefs (tel: and a Google Maps search URL) are absolute-external or
// scheme links, never a root-relative path, so this component needs no
// knowledge of the GitHub Pages base path.
interface Props {
  phone: string;
  address?: string;
}

const { phone, address } = Astro.props;
const telHref = `tel:${phone.replace(/[^0-9+]/g, '')}`;
const directionsHref = address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`
  : undefined;
---

<div class="sticky-call-bar" role="navigation" aria-label="Contact">
  <a class="sticky-call-bar__action" href={telHref}>
    <span aria-hidden="true">📞</span> Call
  </a>
  {
    directionsHref && (
      <a class="sticky-call-bar__action sticky-call-bar__action--directions" href={directionsHref} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">📍</span> Directions
      </a>
    )
  }
</div>

<style>
  .sticky-call-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 30;
    display: flex;
    background: var(--color-surface-raised);
    border-top: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .sticky-call-bar__action {
    flex: 1 1 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-height: var(--tap-target-min);
    font-weight: var(--weight-medium);
    color: var(--color-on-primary);
    background: var(--color-primary);
  }

  .sticky-call-bar__action--directions {
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-left: 1px solid var(--color-surface-raised);
  }

  @media (min-width: 64rem) {
    /* Desktop is the adaptation: header/footer contact info is already
       reachable, so the fixed bar steps back to avoid double conversion UI. */
    .sticky-call-bar {
      display: none;
    }
  }
</style>
