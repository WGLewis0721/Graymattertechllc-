---
// ItemShowcase — an image-forward grid of priced items: photo, name,
// price, optional description. Added once two verticals independently
// needed the identical shape: entrepreneurs' "ProductShelf" and
// food-trucks-and-services' "MenuBoard". Import it directly rather than
// building a per-vertical copy. Different from ServiceCard, which has
// no image and suits offerings that aren't photographed individually
// (coaching programs, legal practice areas). If an item genuinely has
// no photo, it belongs in a ServiceCard list instead of this component
// with a placeholder image.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  image: ImageMetadata;
  imageAlt: string;
  name: string;
  price: string;
  description?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ul class="item-showcase">
  {
    items.map((item) => (
      <li class="item-showcase__card">
        <Image
          class="item-showcase__image"
          src={item.image}
          alt={item.imageAlt}
          widths={[300, 500, 700]}
          sizes="(min-width: 48rem) 30vw, 85vw"
          loading="lazy"
        />
        <div class="item-showcase__body">
          <div class="item-showcase__row">
            <p class="item-showcase__name">{item.name}</p>
            <p class="item-showcase__price">{item.price}</p>
          </div>
          {item.description && <p class="item-showcase__description">{item.description}</p>}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .item-showcase {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .item-showcase {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .item-showcase {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .item-showcase__card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-raised);
  }

  .item-showcase__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .item-showcase__body {
    padding: var(--space-sm);
  }

  .item-showcase__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .item-showcase__name {
    font-weight: var(--weight-medium);
    font-size: var(--text-lg);
  }

  .item-showcase__price {
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .item-showcase__description {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
</style>
