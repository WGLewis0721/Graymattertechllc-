{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "content.json"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@lib/*": ["src/lib/*"],
      "@components/*": ["src/components/*"],
      "@styles/*": ["src/styles/*"]
    }
  }
}
