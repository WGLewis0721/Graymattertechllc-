---
// ServiceCard — one line item in a services/offerings list. Renders as
// a <li>; the parent page/section supplies the enclosing <ul>.
interface Props {
  name: string;
  price: string;
  duration?: string;
  description?: string;
}

const { name, price, duration, description } = Astro.props;
---

<li class="service-card">
  <div class="service-card__row">
    <h3 class="service-card__name">{name}</h3>
    <span class="service-card__price">{price}</span>
  </div>
  {duration && <p class="service-card__duration">{duration}</p>}
  {description && <p class="service-card__description">{description}</p>}
</li>

<style>
  .service-card {
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }

  /* wrap + min-width:0 so a price that is a phrase rather than a figure
     ("Commission on close, quoted up front", "No cost to you") drops to its
     own line instead of forcing the card wider than the viewport. A short
     price still sits inline opposite the name, unchanged. */
  .service-card__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .service-card__name,
  .service-card__price {
    min-width: 0;
  }

  .service-card__name {
    font-size: var(--text-lg);
  }

  .service-card__price {
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    overflow-wrap: break-word;
  }

  .service-card__duration {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .service-card__description {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
</style>
