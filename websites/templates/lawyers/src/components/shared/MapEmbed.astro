---
// MapEmbed — the one place a raw third-party iframe is allowed in this
// system. Lazy-loaded and sandboxed per docs/SECURITY.md ("third-party
// embeds are the main real risk"). Never inline a maps script tag
// instead of this component. Its origin (https://www.google.com or
// https://maps.google.com) must be present in BaseLayout's CSP
// frame-src for this to render at all.
interface Props {
  embedUrl: string;
  title: string;
}

const { embedUrl, title } = Astro.props;
---

<div class="map-embed">
  <iframe
    src={embedUrl}
    title={title}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    sandbox="allow-scripts allow-same-origin allow-popups"
    allowfullscreen={false}
  ></iframe>
</div>

<style>
  .map-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .map-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
