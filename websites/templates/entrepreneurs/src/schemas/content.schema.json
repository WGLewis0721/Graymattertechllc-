{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graymattertech.example/schemas/content.schema.json",
  "title": "Client content.json (entrepreneurs)",
  "description": "Single source of truth for a client site's copy, contact info, hours, image references, and launch state. See websites/docs/ARCHITECTURE.md for the core contract this schema enforces; `products`, `offer`, `story`, and `links` are this vertical's own additive extensions, added locally to this template's copy of the schema, not to the shared library schema. A file that fails this schema fails the build — see src/lib/content.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["business", "hero", "hours", "services", "gallery", "theme", "formEndpoint", "seo"],
  "properties": {
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "alt"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "ctaLabel": { "type": "string" },
        "ctaHref": { "type": "string" }
      }
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "phone"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string" },
        "phone": {
          "type": "string",
          "pattern": "^\\+?[0-9()\\-\\s.]{7,}$",
          "description": "Tap-to-call target. Include country code for reliability, e.g. +1-555-010-0100."
        },
        "email": { "type": "string", "format": "email" },
        "address": { "type": "string" },
        "serviceArea": {
          "type": "string",
          "description": "Used instead of address for service-area-only businesses with no storefront."
        }
      },
      "anyOf": [
        { "required": ["address"] },
        { "required": ["serviceArea"] }
      ]
    },
    "hours": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "open", "close"],
        "properties": {
          "day": { "type": "string", "minLength": 1 },
          "open": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
          "close": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "price"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "price": { "type": "string", "minLength": 1 },
          "duration": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "alt"],
        "properties": {
          "src": { "type": "string", "minLength": 1 },
          "alt": {
            "type": "string",
            "minLength": 1,
            "description": "Required. A missing or empty alt fails the build; see docs/ENGINEERING.md principle 6."
          }
        }
      }
    },
    "testimonials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "author"],
        "properties": {
          "quote": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "role": { "type": "string" }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontPairing", "colorScheme"],
      "properties": {
        "fontPairing": { "type": "string", "minLength": 1 },
        "colorScheme": { "type": "string", "minLength": 1 },
        "colors": {
          "type": "object",
          "description": "Optional explicit token overrides, used only when a client's brand color is matched exactly instead of picked from the curated list. See docs/INTAKE.md.",
          "additionalProperties": false,
          "properties": {
            "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
            "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
            "surface": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
            "ink": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" }
          }
        }
      }
    },
    "formEndpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://formspree\\.io/f/",
      "description": "Formspree endpoint only. Netlify Forms does not work on GitHub Pages (docs/SECURITY.md) and is never a valid value here."
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embedUrl", "title"],
      "properties": {
        "embedUrl": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instagram": { "type": "string", "format": "uri" },
        "facebook": { "type": "string", "format": "uri" },
        "google": { "type": "string", "format": "uri" },
        "yelp": { "type": "string", "format": "uri" }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "minLength": 1, "maxLength": 160 },
        "ogImage": { "type": "string" }
      }
    },
    "launched": {
      "type": "boolean",
      "default": false,
      "description": "Controls both the <meta name=\"robots\"> tag and robots.txt (scripts/generate-robots.mjs). False (the default, every template and the demo client ship this way) means noindex,nofollow and a disallow-all robots.txt. Flipped to true only as the explicit launch-checklist step in docs/DEPLOYMENT.md, never automatically."
    },
    "site": {
      "type": "string",
      "format": "uri",
      "description": "Optional override for astro.config.mjs's `site`. The SITE_URL env var takes precedence when set. See docs/DEPLOYMENT.md, stage 2, step 1."
    },
    "base": {
      "type": "string",
      "pattern": "^/",
      "description": "Optional override for astro.config.mjs's `base`. '/' for a custom domain, '/<repo>' for a username.github.io/<repo> URL. The BASE_PATH env var takes precedence when set."
    },
    "products": {
      "type": "array",
      "description": "This vertical's own extension: the product shelf rendered by the shared ItemShowcase component (labeled \"ProductShelf\" on the page).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image", "imageAlt", "name", "price"],
        "properties": {
          "image": { "type": "string", "minLength": 1 },
          "imageAlt": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "price": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "offer": {
      "type": "object",
      "description": "This vertical's own extension: the single promotional callout rendered by src/components/OfferBlock.astro.",
      "additionalProperties": false,
      "required": ["heading", "description", "ctaLabel", "ctaHref"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "ctaLabel": { "type": "string", "minLength": 1 },
        "ctaHref": { "type": "string", "minLength": 1 }
      }
    },
    "story": {
      "type": "object",
      "description": "This vertical's own extension: the founder portrait + narrative rendered by src/components/StoryPanel.astro.",
      "additionalProperties": false,
      "required": ["photo", "photoAlt", "story"],
      "properties": {
        "photo": { "type": "string", "minLength": 1 },
        "photoAlt": { "type": "string", "minLength": 1 },
        "story": { "type": "string", "minLength": 1 }
      }
    },
    "links": {
      "type": "array",
      "description": "This vertical's own extension: the link-in-bio-style stack rendered by src/components/LinkHub.astro. Absolute or scheme (tel:, sms:) URLs only, per components/shared/README.md's base-path rule.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "href"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
