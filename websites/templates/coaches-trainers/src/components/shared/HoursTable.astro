---
// HoursTable — business hours. Real <table> markup, not divs, so
// screen readers get correct row/column semantics for free.
interface Hours {
  day: string;
  open: string | null;
  close: string | null;
}

interface Props {
  hours: Hours[];
}

const { hours } = Astro.props;

function formatTime(value: string | null): string {
  if (!value) return 'Closed';
  const [h, m] = value.split(':').map(Number);
  const period = h >= 12 ? 'PM' : 'AM';
  const hour12 = h % 12 === 0 ? 12 : h % 12;
  return m === 0 ? `${hour12}${period}` : `${hour12}:${String(m).padStart(2, '0')}${period}`;
}
---

<table class="hours-table">
  <caption class="visually-hidden">Business hours</caption>
  <tbody>
    {
      hours.map((h) => (
        <tr>
          <th scope="row">{h.day}</th>
          <td>
            {h.open && h.close ? `${formatTime(h.open)} – ${formatTime(h.close)}` : 'Closed'}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .hours-table {
    width: 100%;
    max-width: var(--container-sm);
    border-collapse: collapse;
  }

  .hours-table tr {
    border-bottom: 1px solid var(--color-border);
  }

  .hours-table th,
  .hours-table td {
    padding-block: var(--space-2xs);
    text-align: left;
    font-weight: var(--weight-regular);
  }

  .hours-table th {
    font-weight: var(--weight-medium);
    width: 40%;
  }
</style>
