---
// BeforeAfterSlider — horizontal scroll-snap strip of before/after image
// pairs. Same native-CSS scroll-snap pattern as SwipeGallery (no JS, no
// library), reused here rather than forked because three verticals
// independently need this exact shape: coaches-trainers'
// "TransformationSlider", contractors' before/after "ProjectGallery",
// and hospitality-and-cleaning's before/after showcase. Per
// docs/ENGINEERING.md, principle 7 ("promote to shared once a second
// vertical needs the same thing"), this is that promotion — a vertical
// template just imports this directly and labels the section whatever
// fits its copy, it does not need its own copy of this component.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface BeforeAfterItem {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  /** Optional short label for this pair, e.g. a client name or project name. */
  label?: string;
}

interface Props {
  items: BeforeAfterItem[];
  /** Unique id prefix for this instance's slide anchors. Required when a page has more than one BeforeAfterSlider. */
  id: string;
  /** CSS aspect-ratio for each before/after image. Default '4 / 3'. */
  aspectRatio?: string;
}

const { items, id, aspectRatio = '4 / 3' } = Astro.props;
const slug = id.replace(/[^a-zA-Z0-9-]/g, '-');

const dotRules = items
  .map(
    (_, i) =>
      `.before-after--${slug}:has(#${slug}-slide-${i}:target) .before-after__dot--${i} { background: var(--color-primary); transform: scale(1.25); }`
  )
  .join('\n');
---

<div class:list={['before-after', `before-after--${slug}`]}>
  <ul class="before-after__track">
    {
      items.map((item, i) => (
        <li id={`${slug}-slide-${i}`} class="before-after__slide">
          {item.label && <p class="before-after__label">{item.label}</p>}
          <div class="before-after__pair">
            <figure class="before-after__figure" style={`aspect-ratio: ${aspectRatio}`}>
              <Image
                src={item.before}
                alt={item.beforeAlt}
                widths={[300, 500, 700]}
                sizes="(min-width: 48rem) 20vw, 42vw"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              <figcaption class="before-after__tag">Before</figcaption>
            </figure>
            <figure class="before-after__figure" style={`aspect-ratio: ${aspectRatio}`}>
              <Image
                src={item.after}
                alt={item.afterAlt}
                widths={[300, 500, 700]}
                sizes="(min-width: 48rem) 20vw, 42vw"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              <figcaption class="before-after__tag">After</figcaption>
            </figure>
          </div>
        </li>
      ))
    }
  </ul>
  <nav class="before-after__dots" aria-label="Before and after position">
    {
      items.map((_, i) => (
        <a
          href={`#${slug}-slide-${i}`}
          class:list={['before-after__dot', `before-after__dot--${i}`]}
          aria-label={`Before and after ${i + 1} of ${items.length}`}
        />
      ))
    }
  </nav>
</div>

{dotRules && <style set:html={dotRules} />}

<style>
  .before-after__track {
    display: flex;
    gap: var(--space-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--container-gutter);
    -webkit-overflow-scrolling: touch;
    padding-inline: var(--container-gutter);
    padding-block: var(--space-3xs);
  }

  .before-after__slide {
    flex: 0 0 92%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  @media (min-width: 48rem) {
    .before-after__slide {
      flex-basis: 60%;
    }
  }

  .before-after__label {
    font-weight: var(--weight-medium);
    margin-bottom: var(--space-2xs);
  }

  .before-after__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xs);
  }

  .before-after__figure {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .before-after__figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .before-after__tag {
    position: absolute;
    left: var(--space-2xs);
    bottom: var(--space-2xs);
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: var(--radius-sm);
    background: var(--color-scrim-strong);
    color: var(--color-on-image);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .before-after__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2xs);
    padding-block: var(--space-sm);
  }

  .before-after__dot {
    width: var(--space-xs);
    height: var(--space-xs);
    border-radius: var(--radius-full);
    background: var(--color-border);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
</style>
