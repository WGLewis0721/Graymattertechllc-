{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graymattertech.example/schemas/content.schema.json",
  "title": "Client content.json",
  "description": "Single source of truth for a client site's copy, contact info, hours, and image references. See websites/docs/ARCHITECTURE.md for the contract this schema enforces. A file that fails this schema fails the build — see src/lib/content.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["business", "hero", "hours", "services", "gallery", "theme", "formEndpoint", "seo"],
  "properties": {
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "alt"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "ctaLabel": { "type": "string" },
        "ctaHref": { "type": "string" }
      }
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "phone"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string" },
        "phone": {
          "type": "string",
          "pattern": "^\\+?[0-9()\\-\\s.]{7,}$",
          "description": "Tap-to-call target. Include country code for reliability, e.g. +1-555-010-0100."
        },
        "email": { "type": "string", "format": "email" },
        "address": { "type": "string" },
        "serviceArea": {
          "type": "string",
          "description": "Used instead of address for service-area-only businesses with no storefront."
        }
      },
      "anyOf": [
        { "required": ["address"] },
        { "required": ["serviceArea"] }
      ]
    },
    "hours": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "open", "close"],
        "properties": {
          "day": { "type": "string", "minLength": 1 },
          "open": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
          "close": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "price"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "price": { "type": "string", "minLength": 1 },
          "duration": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "alt"],
        "properties": {
          "src": { "type": "string", "minLength": 1 },
          "alt": {
            "type": "string",
            "minLength": 1,
            "description": "Required. A missing or empty alt fails the build; see docs/ENGINEERING.md principle 6."
          }
        }
      }
    },
    "testimonials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "author"],
        "properties": {
          "quote": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "role": { "type": "string" }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontPairing", "colorScheme"],
      "properties": {
        "fontPairing": { "type": "string", "minLength": 1 },
        "colorScheme": { "type": "string", "minLength": 1 },
        "colors": {
          "type": "object",
          "description": "Optional explicit token overrides, used only when a client's brand color is matched exactly instead of picked from the curated list. See docs/INTAKE.md.",
          "additionalProperties": false,
          "properties": {
            "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
            "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
            "surface": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
            "ink": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" }
          }
        }
      }
    },
    "formEndpoint": {
      "type": "string",
      "format": "uri",
      "description": "Third-party form provider endpoint (Formspree or Netlify Forms). Never a same-origin API route; this system has no backend."
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embedUrl", "title"],
      "properties": {
        "embedUrl": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instagram": { "type": "string", "format": "uri" },
        "facebook": { "type": "string", "format": "uri" },
        "google": { "type": "string", "format": "uri" },
        "yelp": { "type": "string", "format": "uri" }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "minLength": 1, "maxLength": 160 },
        "ogImage": { "type": "string" }
      }
    }
  }
}
