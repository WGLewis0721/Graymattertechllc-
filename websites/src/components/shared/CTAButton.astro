---
// CTAButton — the one clickable call-to-action element every other
// component uses (Hero, StickyCallBar, ContactForm submit). A single
// <a>-based button so it works identically with or without JS.
interface Props {
  label: string;
  href: string;
  variant?: 'primary' | 'accent' | 'outline';
  /** Renders as <button type="submit"> instead of <a>, for form submission. */
  type?: 'link' | 'submit';
}

const { label, href, variant = 'primary', type = 'link' } = Astro.props;
const classes = ['cta-button', `cta-button--${variant}`];
---

{
  type === 'submit' ? (
    <button type="submit" class:list={classes}>
      {label}
    </button>
  ) : (
    <a href={href} class:list={classes}>
      {label}
    </a>
  )
}

<style>
  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-target-min);
    padding-inline: var(--space-md);
    border-radius: var(--radius-md);
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    text-align: center;
    text-decoration: none;
    border: 2px solid transparent;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .cta-button--primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .cta-button--primary:hover {
    background: var(--color-primary-hover);
  }

  .cta-button--accent {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .cta-button--accent:hover {
    background: var(--color-accent-hover);
  }

  .cta-button--outline {
    background: transparent;
    color: var(--color-primary);
    border-color: currentColor;
  }

  .cta-button--outline:hover {
    background: var(--color-surface-alt);
  }
</style>
