---
// SwipeGallery — horizontal scroll-snap gallery. Native CSS only: no JS,
// no carousel library (docs/PHILOSOPHY.md, "swipe first"). Position
// indicator dots double as tap targets: tapping a dot jumps to that
// slide via an in-page anchor, and :target styles the matching dot as
// active. This is a deliberate, honest tradeoff — pure CSS can jump to
// a slide and reflect that in the indicator, but it cannot observe a
// free-swipe's live scroll offset without JS. Do not add a JS scroll
// listener to "fix" this; if live position tracking becomes a real
// requirement, that is an opt-in island, not a change to this component's
// no-JS baseline.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryImage {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  images: GalleryImage[];
  /** Unique id prefix for this gallery instance's slide anchors. Required when a page has more than one SwipeGallery. */
  id: string;
  /** CSS aspect-ratio for each slide. Default '4 / 3'. */
  aspectRatio?: string;
}

const { images, id, aspectRatio = '4 / 3' } = Astro.props;
const slug = id.replace(/[^a-zA-Z0-9-]/g, '-');

const dotRules = images
  .map(
    (_, i) =>
      `.swipe-gallery--${slug}:has(#${slug}-slide-${i}:target) .swipe-gallery__dot--${i} { background: var(--color-primary); transform: scale(1.25); }`
  )
  .join('\n');
---

<div class:list={['swipe-gallery', `swipe-gallery--${slug}`]}>
  <ul class="swipe-gallery__track">
    {
      images.map((img, i) => (
        <li id={`${slug}-slide-${i}`} class="swipe-gallery__slide" style={`aspect-ratio: ${aspectRatio}`}>
          <Image
            src={img.image}
            alt={img.alt}
            widths={[400, 700, 1000]}
            sizes="(min-width: 48rem) 40vw, 85vw"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </li>
      ))
    }
  </ul>
  <nav class="swipe-gallery__dots" aria-label="Gallery position">
    {
      images.map((_, i) => (
        <a
          href={`#${slug}-slide-${i}`}
          class:list={['swipe-gallery__dot', `swipe-gallery__dot--${i}`]}
          aria-label={`Photo ${i + 1} of ${images.length}`}
        />
      ))
    }
  </nav>
</div>

{dotRules && <style set:html={dotRules} />}

<style>
  .swipe-gallery__track {
    display: flex;
    gap: var(--space-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--container-gutter);
    -webkit-overflow-scrolling: touch;
    padding-inline: var(--container-gutter);
    padding-block: var(--space-3xs); /* room for the focus ring on scroll-snapped items */
  }

  .swipe-gallery__slide {
    flex: 0 0 85%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .swipe-gallery__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 48rem) {
    .swipe-gallery__slide {
      flex-basis: 38%;
    }
  }

  .swipe-gallery__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2xs);
    padding-block: var(--space-sm);
  }

  .swipe-gallery__dot {
    width: var(--space-xs);
    height: var(--space-xs);
    border-radius: var(--radius-full);
    background: var(--color-border);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
</style>
