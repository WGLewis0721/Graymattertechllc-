---
// Hero — the top-of-page banner. Must be swappable between any two
// verticals without changing its call signature (docs/ENGINEERING.md,
// principle 2). Image is always a resolved ImageMetadata object, never
// a bare src string — see components/shared/README.md for why.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CTAButton from './CTAButton.astro';

interface Props {
  heading: string;
  subheading?: string;
  image: ImageMetadata;
  imageAlt: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { heading, subheading, image, imageAlt, ctaLabel, ctaHref } = Astro.props;
---

<section class="hero">
  <Image
    class="hero__image"
    src={image}
    alt={imageAlt}
    widths={[480, 768, 1200, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__scrim"></div>
  <div class="container hero__content">
    <h1 class="hero__heading">{heading}</h1>
    {subheading && <p class="hero__subheading">{subheading}</p>}
    {ctaLabel && ctaHref && <CTAButton label={ctaLabel} href={ctaHref} variant="accent" />}
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 60vh;
  }

  .hero__image {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .hero__scrim {
    grid-area: 1 / 1;
    background: linear-gradient(to top, var(--color-scrim-strong), var(--color-scrim-soft) 60%);
  }

  .hero__content {
    grid-area: 1 / 1;
    align-self: end;
    padding-block: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .hero__heading {
    color: var(--color-on-image);
    font-size: var(--text-3xl);
  }

  .hero__subheading {
    color: var(--color-on-image);
    font-size: var(--text-lg);
    max-width: 40ch;
  }

  @media (min-width: 48rem) {
    .hero {
      min-height: 70vh;
    }

    .hero__heading {
      font-size: var(--text-4xl);
    }
  }
</style>
