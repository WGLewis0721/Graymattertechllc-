---
// Demo/smoke-test page for the shared frame. Renders every shared
// component against examples/demo-client/content.json so the frame can
// be built and checked end to end before any vertical template exists.
// This is not a vertical template — see templates/README.md. A real
// vertical template composes its own pages; this file exists to prove
// the frame works, including under a non-root GitHub Pages base (see
// astro.config.mjs and docs/DEPLOYMENT.md).
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/shared/Header.astro';
import Hero from '../components/shared/Hero.astro';
import Section from '../components/shared/Section.astro';
import ServiceCard from '../components/shared/ServiceCard.astro';
import SwipeGallery from '../components/shared/SwipeGallery.astro';
import TestimonialStrip from '../components/shared/TestimonialStrip.astro';
import HoursTable from '../components/shared/HoursTable.astro';
import ContactForm from '../components/shared/ContactForm.astro';
import MapEmbed from '../components/shared/MapEmbed.astro';
import Footer from '../components/shared/Footer.astro';
import { loadContent } from '../lib/content';
import rawContent from '../../examples/demo-client/content.json';

const content = loadContent(rawContent);

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../examples/demo-client/images/*.{png,jpg,jpeg}',
  { eager: true }
);

function resolveImage(filename: string): ImageMetadata {
  const match = Object.entries(imageModules).find(([path]) => path.endsWith(`/${filename}`));
  if (!match) throw new Error(`No demo image found for "${filename}"`);
  return match[1].default;
}

const heroImage = resolveImage(content.hero.image);
const galleryImages = content.gallery.map((item) => ({
  image: resolveImage(item.src),
  alt: item.alt,
}));

// In-page anchors only — no root-relative paths, so this page is
// correct under any `base` (docs/components/shared/README.md, "GitHub
// Pages base path").
const nav = [
  { label: 'Services', href: '#services' },
  { label: 'Gallery', href: '#gallery' },
  { label: 'Hours', href: '#hours' },
  { label: 'Contact', href: '#contact' },
];
---

<BaseLayout content={content} businessType="BarberShop">
  <Header
    businessName={content.business.name}
    nav={nav}
    ctaLabel="Call now"
    ctaHref={`tel:${content.business.phone.replace(/[^0-9+]/g, '')}`}
  />

  <main id="main">
    <Hero
      heading={content.business.name}
      subheading={content.business.tagline}
      image={heroImage}
      imageAlt={content.hero.alt}
      ctaLabel={content.hero.ctaLabel}
      ctaHref={content.hero.ctaHref}
    />

    <Section id="services" heading="Services">
      <ul class="services-grid">
        {
          content.services.map((service) => (
            <ServiceCard
              name={service.name}
              price={service.price}
              duration={service.duration}
              description={service.description}
            />
          ))
        }
      </ul>
    </Section>

    <Section id="gallery" heading="Gallery" background="alt">
      <SwipeGallery id="demo-gallery" images={galleryImages} />
    </Section>

    {
      content.testimonials && content.testimonials.length > 0 && (
        <Section heading="What clients say">
          <TestimonialStrip testimonials={content.testimonials} />
        </Section>
      )
    }

    <Section id="hours" heading="Hours" background="alt">
      <HoursTable hours={content.hours} />
    </Section>

    <Section id="contact" heading="Get in touch">
      <ContactForm endpoint={content.formEndpoint} />
      {content.map && <MapEmbed embedUrl={content.map.embedUrl} title={content.map.title} />}
    </Section>
  </main>

  <Footer
    businessName={content.business.name}
    phone={content.business.phone}
    email={content.business.email}
    address={content.business.address}
    social={content.social}
  />
</BaseLayout>

<style>
  .services-grid {
    display: grid;
    gap: var(--space-sm);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
